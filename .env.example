# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Model selection ───────────────────────────────────────────────────────────
# Whisper model: tiny | base | small | medium | large-v2 | large-v3
WHISPER_MODEL=large-v3
# Claude model: claude-opus-4-6 | claude-sonnet-4-6 | claude-haiku-4-...
CLAUDE_MODEL=claude-sonnet-4-6

# ── Pipeline behaviour ────────────────────────────────────────────────────────
# Max short clip duration in seconds (YouTube Shorts hard cap is 60s)
MAX_CLIP_DURATION=90
MIN_CLIP_DURATION=30
# How many clips to produce per lecture
TARGET_CLIP_COUNT=5

# ── Paths ─────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./outputs
CACHE_DIR=./cache

# ── Domain ────────────────────────────────────────────────────────────────────
# Domain hint fed to LLM for domain-aware scoring
# Options: khutba | podcast | business_talk | lecture | generic
DEFAULT_DOMAIN=khutba
